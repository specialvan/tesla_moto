{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SyntheticFluxLut",
  "type": "object",
  "required": [
    "version",
    "purpose",
    "motor_id",
    "pole_pairs",
    "unit_convention",
    "id_axis_a",
    "iq_axis_a",
    "lambda_d_wb",
    "lambda_q_wb",
    "maturity"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "motor_id": {
      "type": "string",
      "minLength": 1
    },
    "pole_pairs": {
      "type": "integer",
      "minimum": 1
    },
    "unit_convention": {
      "type": "object",
      "required": [
        "dq_transform",
        "current",
        "flux_linkage"
      ],
      "properties": {
        "dq_transform": {
          "const": "amplitude_invariant"
        },
        "current": {
          "const": "phase_peak_ampere"
        },
        "flux_linkage": {
          "const": "weber"
        }
      },
      "additionalProperties": false
    },
    "id_axis_a": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2
    },
    "iq_axis_a": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2
    },
    "lambda_d_wb": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2
      },
      "minItems": 2
    },
    "lambda_q_wb": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2
      },
      "minItems": 2
    },
    "maturity": {
      "type": "object",
      "required": [
        "model_maturity",
        "physics_model_validated",
        "engineering_validated",
        "production_release_allowed",
        "required_replacement"
      ],
      "properties": {
        "model_maturity": {
          "const": "synthetic_fixture"
        },
        "physics_model_validated": {
          "const": false
        },
        "engineering_validated": {
          "const": false
        },
        "production_release_allowed": {
          "const": false
        },
        "required_replacement": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
